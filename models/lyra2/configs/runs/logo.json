    "NFT_LOG_CAMERA": "1",
    "NFT_NCCL_TIMEOUT_MIN": "45",
    "NFT_NORM_OVERRIDE": "{\"rpe_rot\": [5.67, 2.2], \"rpe_trans\": [0.0253, 0.006]}",
