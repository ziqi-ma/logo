    "NFT_REWARD_MIX": "0.5",
    "NFT_REWARD_VOXEL": "0.1",
    "NFT_TRAIN_TIMESTEPS": "0",
    "NFT_VOXEL_LOCAL": "0.5",
    "NFT_VOXEL_PATCH": "latent",
    "NUM_FRAMES": "241",
    "NUM_STEPS": "300",
    "POLICY_LORA_URI": "hf://nvidia/Lyra-2.0/checkpoints/lora/dmd_distillation.safetensors",
    "POSE_SCALE": "0.4",
    "PYTHONHASHSEED": "0",
    "PYTHONUNBUFFERED": "1",
    "REF_LORA_URI": "hf://nvidia/Lyra-2.0/checkpoints/lora/dmd_distillation.safetensors",
    "RESOLUTION": "480,832",
    "SCENES_PARALLEL": "8",
    "SCENE_INPUT_BASE_URI": "s3://videogen-rl/training_data/dl3dv-mirror-train-fhalf241",
    "SKIP_WEIGHT_DOWNLOAD": "1",
    "VAL_EVERY": "5",
    "VAL_FULL_VIDEOGPA": "1",
    "VAL_K": "4",
    "VAL_METRICS": "hpsv3_vid,rpe_rot,rpe_trans",
    "VGGT_CKPT_URI": "hf://facebook/VGGT-Omega/vggt_omega_1b_512.pt",
    "VIDEOS_EVERY": "20",
    "WANDB_NAME": "nft-loop-logo",
    "WANDB_PROJECT": "lyra-diffnft"
  }
}
