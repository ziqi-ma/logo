{
  "run": "logo",
  "topology": {
    "gpus_total": 64,
    "gpu_type": "H100",
    "gpus_per_worker": 8,
    "workers_per_replica": 8
  },
  "envvars": {
    "VGGT_CHECKPOINT": "/weights/vggt/vggt_omega_1b_512.pt",
    "VGGT_PY": "/opt/conda/envs/lyra2/bin/python",
    "CHECKPOINT_URI": "hf://nvidia/Lyra-2.0/checkpoints",
    "CKPT_EVERY": "1",
    "DNC_VGGT_CKPT_URI": "hf://facebook/VGGT-Omega/vggt_omega_1b_512.pt",
    "EMA_DECAY": "0.9",
    "GRAD_STEPS": "1",
    "HF_HOME": "/tmp/hf_home_lyra2",
    "INNER_EPOCHS": "1",
    "K_ROLLOUTS": "16",
    "LR": "3.33e-5",
    "NCCL_DEBUG": "WARN",
    "NCCL_NET_PLUGIN": "none",
    "NCCL_TUNER_PLUGIN": "none",
    "NEW_LORA_URI": "s3://videogen-rl/checkpoints/lyra/logo/<your-run-name>",
    "NFT_BETA_KL": "1e-4",
    "NFT_COMBINE_MODE": "sum",
    "NFT_COMBO": "reproj_rgbd",
    "NFT_COMBO_SCHEDULE": "reproj_rgbd_g70:5,hpsv3_only:6,camera_only:3",
